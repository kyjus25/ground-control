GC_DATA_ROOT=./data

# Postgres connection used by the app and drizzle-kit (bun auto-loads this file).
DATABASE_URL=postgres://groundcontrol:groundcontrol@localhost:5433/groundcontrol

# Account creation (signup) is gated behind this flag. Set to "true" to allow
# new accounts to be created from the login page.
ENABLE_SIGNUP=true

# Z.AI (OpenAI-compatible). Get a key at https://z.ai — model catalog in src/types/ai.ts
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Chat loop guards (§3.5). GC_REPLY_DEPTH caps bot-to-bot handoff hops per
# turn (default 3); GC_COOLDOWN_MS is the minimum gap in milliseconds
# between user turns in one thread (default 3000).
GC_REPLY_DEPTH=3
GC_COOLDOWN_MS=3000
GC_COMPACTION_MAX_TOKENS=24000
GC_COMPACTION_TYPE=summarize-oldest
